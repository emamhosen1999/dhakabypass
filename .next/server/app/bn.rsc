15:["$","section","1",{"className":"db-hero","children":[["$","div",null,{"className":"db-hero-bg","aria-hidden":"true","children":["$","img",null,{"src":"/bg-hero.webp","alt":"","width":686,"height":386,"sizes":"100vw","className":"$undefined","loading":"eager","decoding":"sync","fetchPriority":"high","style":{"objectPosition":"50% 50%"}}]}],["$","div",null,{"className":"db-hero-inner","children":[["$","p",null,{"className":"db-hero-eyebrow","children":"Dhaka Bypass Expressway"}],["$","h1",null,{"className":"db-hero-title","children":"আঠারো কিলোমিটার খোলা, টোল আদায় চালু"}],["$","p",null,{"className":"db-hero-standfirst","children":"বাইপাসের প্রথম অংশ আজ Vogra ও Purbachal-এর মধ্যে যান চলাচল বহন করছে। ৪৮ কিলোমিটার করিডোরের বাকি অংশ এখনও নির্মাণাধীন।"}],["$","p",null,{"className":"db-actions","children":[["$","$L12",null,{"href":"/bn/travel/toll","className":"db-btn db-btn-primary","children":"টোল হার"}],["$","$L12",null,{"href":"/bn/travel/status","className":"db-btn db-btn-ondark","children":"কী খোলা আছে"}]]}]]}]]}]
17:["$","section","3",{"className":"db-block db-mediaprose","children":[["$","div",null,{"className":"db-mediaprose-text","children":[["$","h2",null,{"className":"db-h2","children":"শহরের ভেতর দিয়ে নয়, শহরকে ঘিরে"}],["$","div",null,{"className":"db-prose","dangerouslySetInnerHTML":{"__html":"<p>Dhaka Bypass রাজধানীর পূর্ব প্রান্ত ধরে উত্তরে গাজীপুর থেকে দক্ষিণে নারায়ণগঞ্জ পর্যন্ত ৪৮ কিলোমিটার বিস্তৃত। উত্তরের শিল্পাঞ্চল ও দক্ষিণের বন্দরগুলির মধ্যে চলাচলকারী পণ্যবাহী যানবাহনকে যাতে ঢাকা পার হয়ে যেতে না হয়, সে জন্যই এই সড়ক।</p><p>এটি নিয়ন্ত্রিত-প্রবেশ সড়ক: যানবাহন কেবল নির্মিত ইন্টারচেঞ্জ দিয়েই ওঠে ও নামে, আর প্রতিটি ক্রসিং আলাদা স্তরে করা। এখানেই এটি সংযুক্ত জাতীয় মহাসড়কগুলির থেকে আলাদা, এবং এ কারণেই শহরের ভেতর দিয়ে যে যাত্রায় দুই ঘণ্টা লাগে, সম্পূর্ণ করিডোর খুলে গেলে তা তার সামান্য সময়েই শেষ হওয়ার কথা।</p>"}}],["$","p",null,{"className":"db-actions","children":["$","$L12",null,{"href":"/bn/travel/route","className":"db-btn db-btn-secondary","children":"কোথায় উঠবেন ও নামবেন"}]}]]}],["$","figure",null,{"className":"db-figure-item db-mediaprose-figure","children":[["$","div",null,{"className":"db-figure db-ratio-photo","children":["$","img",null,{"src":"/bypass-ex.webp","alt":"ক্যারেজওয়ের উপরে একটি গ্যান্ট্রিতে লেখা “Welcome to Dhaka Bypass Expressway”, তার ওপাশে টোল প্লাজা ও ট্রাক","width":696,"height":408,"sizes":"(max-width: 860px) 100vw, 46vw","className":"$undefined","loading":"lazy","decoding":"async","fetchPriority":"$undefined","style":{"objectPosition":"50% 50%"}}]}],["$","figcaption",null,{"children":"খোলা অংশের নির্মিত ক্যারেজওয়ে।"}]]}]]}]
18:["$","section","6",{"className":"db-block db-mediaprose db-mediaprose-left","children":[["$","div",null,{"className":"db-mediaprose-text","children":[["$","h2",null,{"className":"db-h2","children":"খোলা অংশ এখন কী বদলাচ্ছে"}],["$","div",null,{"className":"db-prose","dangerouslySetInnerHTML":{"__html":"<p>আগে যে যানবাহনকে গাজীপুরের ভেতর দিয়ে যানজটে দাঁড়িয়ে থাকতে হতো, তা এখন টোল দিয়ে খোলা অংশ ব্যবহার করতে পারে। পণ্যপরিবহন সংস্থার কাছে এর হিসাব কিলোমিটার সাশ্রয়ে নয় — দাঁড়িয়ে থাকা অবস্থায় পুড়ে যাওয়া জ্বালানি আর চালকের কর্মঘণ্টায়।</p><p>করিডোরটি নির্মিত ও পরিচালিত হচ্ছে একটি সরকারি–বেসরকারি অংশীদারত্বের অধীনে, যার আওতায় রয়েছে নকশা, নির্মাণ, অর্থায়ন, পরিচালনা ও রক্ষণাবেক্ষণ। এর খরচ ওঠে টোল থেকেই।</p><p class=\"db-provisional-inline\">নির্মাণকালে এই প্রকল্প নিয়ে যেসব হিসাব প্রকাশিত হয়েছিল — মোট বিনিয়োগ, সৃষ্ট কর্মসংস্থান, নির্মিত সেতু ও আন্ডারপাসের সংখ্যা, কনসেশনের মেয়াদ — সড়ক খুলে দেওয়ার পর সেগুলি আর নিশ্চিত করা হয়নি। DBEDC যাচাই না করা পর্যন্ত সেগুলি এখানে পুনঃপ্রকাশ করা হচ্ছে না।</p>"}}],["$","p",null,{"className":"db-actions","children":["$","$L12",null,{"href":"/bn/travel/status","className":"db-btn db-btn-secondary","children":"আজকের করিডোর"}]}]]}],["$","figure",null,{"className":"db-figure-item db-mediaprose-figure","children":[["$","div",null,{"className":"db-figure db-ratio-photo","children":["$","img",null,{"src":"/photo/16.webp","alt":"সদ্য শেষ হওয়া পিচঢালা পৃষ্ঠ, নতুন পৃষ্ঠের উপর দিয়ে কয়েকজন হেঁটে যাচ্ছেন","width":416,"height":312,"sizes":"(max-width: 860px) 100vw, 46vw","className":"$undefined","loading":"lazy","decoding":"async","fetchPriority":"$undefined","style":{"objectPosition":"50% 50%"}}]}],["$","figcaption",null,{"children":"খোলা অংশের চূড়ান্ত পৃষ্ঠস্তর।"}]]}]]}]
