d:[["$","title","0",{"children":"Dhaka Bypass Expressway — 通行费、路线与通行信息"}],["$","meta","1",{"name":"description","content":"Dhaka Bypass Expressway 目前在 Vogra 至 Purbachal 之间的18公里路段通车并收费——通行费标准、路线走向以及今日通行状况，均可在此查询。"}],["$","link","2",{"rel":"canonical","href":"https://dhakabypass.com/zh"}],["$","link","3",{"rel":"alternate","hrefLang":"en","href":"https://dhakabypass.com/en"}],["$","link","4",{"rel":"alternate","hrefLang":"bn","href":"https://dhakabypass.com/bn"}],["$","link","5",{"rel":"alternate","hrefLang":"zh","href":"https://dhakabypass.com/zh"}],["$","link","6",{"rel":"alternate","hrefLang":"x-default","href":"https://dhakabypass.com/en"}],["$","link","7",{"rel":"icon","href":"/favicon.ico","type":"image/x-icon","sizes":"16x16"}]]
