6:[["$","section",null,{"className":"db-block","children":[["$","p",null,{"className":"db-eyebrow","children":"যোগাযোগ"}],["$","h1",null,{"className":"db-h1","children":"DBEDC-এর সঙ্গে যোগাযোগ"}],["$","p",null,{"className":"db-lede","children":"প্রশ্ন করুন, এক্সপ্রেসওয়ের কোনও সমস্যা জানান, কিংবা কোনও নথি চেয়ে নিন।"}]]}],["$","section",null,{"className":"db-block db-contact-grid","children":[["$","div",null,{"children":[["$","h2",null,{"className":"db-h2","children":"বার্তা পাঠান"}],["$","p",null,{"className":"db-prose","children":"প্রতিটি বার্তা DBEDC-এর কাছে পৌঁছায়। আপনার বার্তা সড়ক সম্পর্কে হলে করিডোরের কোথায় এবং কখন, তা জানান।"}],["$","$L13",null,{"labels":{"name":"আপনার নাম","email":"ইমেইল ঠিকানা","subject":"বিষয়","message":"বার্তা","send":"বার্তা পাঠান","sending":"পাঠানো হচ্ছে…","sentHeading":"বার্তা পাঠানো হয়েছে","sentBody":"ধন্যবাদ। আপনার বার্তা সংরক্ষিত হয়েছে এবং DBEDC-এর কাছে পৌঁছাবে।","errorRequired":"অনুগ্রহ করে আপনার নাম, উত্তর দেওয়ার মতো একটি ইমেইল ঠিকানা এবং বার্তা দিন।","errorUnavailable":"আপনার বার্তা সংরক্ষণ করা যায়নি — কিছুই সংরক্ষিত হয়নি। অনুগ্রহ করে কিছুক্ষণ পর আবার চেষ্টা করুন, অথবা DBEDC-এর সঙ্গে যোগাযোগের অন্য পথ ব্যবহার করুন।","privacy":"আপনার নাম ও ইমেইল কেবল আপনাকে উত্তর দেওয়ার জন্য ব্যবহৃত হয়।","honeypot":"প্রতিষ্ঠান (খালি রাখুন)"}}]]}],["$","aside",null,{"className":"db-contact-aside","children":[["$","h2",null,{"className":"db-h2","children":"কার্যালয় ও টেলিফোন"}],["$","p",null,{"className":"db-pending","children":[["$","span",null,{"className":"db-pending-tag","children":"এখনও প্রকাশিত হয়নি"}],"নিবন্ধিত কার্যালয়ের ঠিকানা, টেলিফোন নম্বর ও ইমেইল ঠিকানা DBEDC এখনও প্রকাশের জন্য নিশ্চিত করেনি, এবং কোনও জরুরি হটলাইনও দেওয়া হয়নি। এখানে কিছুই অনুমান করা হয়নি: যোগাযোগের পাতায় ভুল নম্বর মানুষকে এই বিশ্বাস নিয়ে ফিরিয়ে দেয় যে তিনি চেষ্টা করেছেন। প্রকাশিত না হওয়া পর্যন্ত ফরমটি ব্যবহার করুন।"]}],["$","h2",null,{"className":"db-h2","children":"অন্যান্য পথ"}],["$","p",null,{"className":"db-prose","children":"টোল, সড়ক, ভূমি অধি