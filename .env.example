# Copy to .env.local and fill in. .env.local is git-ignored and must never be
# committed. This file carries NAMES and shapes only — never a real value.

# ---------------------------------------------------------------------------
# Site identity
# ---------------------------------------------------------------------------
# The site's own absolute origin. Read only on the server, at request time, by
# lib/seo/site.js — it is the single source of the domain for robots.txt,
# sitemap.xml, every canonical URL and every hreflang alternate. Nothing else in
# the codebase may hardcode the domain.
#
# Deliberately NOT a NEXT_PUBLIC_ name: this app is built locally and the
# artefact uploaded to cPanel (next.config.mjs `output: 'standalone'`), and a
# NEXT_PUBLIC_ value would be inlined at build time, freezing the builder's
# domain into every deployed build. As a server variable the operator can change
# the domain in the cPanel environment editor and restart.
#
# Defaults to http://localhost:3000 when unset, so development and Playwright
# work with no configuration. Set it explicitly in production.
SITE_URL=https://dhakabypass.com

# ---------------------------------------------------------------------------
# Database (mysql2, no ORM)
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Auth (NextAuth)
# ---------------------------------------------------------------------------
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAIL=
ADMIN_EMAILS=
ADMIN_NAME=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Where admin uploads are written. Outside public/ on purpose; served by
# app/uploads/[...path]/route.js.
MEDIA_ROOT=

# ---------------------------------------------------------------------------
# Analytics — optional, and OFF unless set
# ---------------------------------------------------------------------------
# Leave ANALYTICS_PROVIDER unset (or 'none') and no analytics script is rendered
# at all. That is the correct setting for staging and for development: a
# hardcoded measurement ID fails by silently mixing staging traffic into the
# production numbers, where nobody notices because the numbers still look
# plausible.
#
#   none        the default. Nothing is rendered.
#   plausible   cookieless. Needs ANALYTICS_SITE_ID (your domain) and
#               ANALYTICS_SCRIPT_URL (the script on your instance).
#   umami       cookieless. Needs ANALYTICS_SITE_ID (the website id) and
#               ANALYTICS_SCRIPT_URL.
#   ga4         Google Analytics 4. Needs ANALYTICS_SITE_ID (G-XXXXXXX).
#
# COOKIES. plausible and umami store nothing on the visitor's device, so they
# need no consent banner. ga4 does set cookies: selecting it also switches on a
# consent banner, and Google Consent Mode is initialised with every storage type
# DENIED until a visitor actively agrees. That is not configurable, because
# measuring without consent is a legal exposure for DBEDC rather than a setting.
#
# WHEN THIS IS READ. The localised pages are prerendered by `next build`, so
# these values are baked into the HTML at build time exactly as SITE_URL is.
# Changing the provider means REBUILDING, not just restarting.
ANALYTICS_PROVIDER=
ANALYTICS_SITE_ID=
ANALYTICS_SCRIPT_URL=
