# Copy to .env.local and fill in. .env.local is git-ignored and must never be
# committed. This file carries NAMES and shapes only — never a real value.

# ---------------------------------------------------------------------------
# Site identity
# ---------------------------------------------------------------------------
# The site's own absolute origin. Read only on the server, at request time, by
# lib/seo/site.js — it is the single source of the domain for robots.txt,
# sitemap.xml, every canonical URL and every hreflang alternate. Nothing else in
# the codebase may hardcode the domain.
#
# Deliberately NOT a NEXT_PUBLIC_ name: this app is built locally and the
# artefact uploaded to cPanel (next.config.mjs `output: 'standalone'`), and a
# NEXT_PUBLIC_ value would be inlined at build time, freezing the builder's
# domain into every deployed build. As a server variable the operator can change
# the domain in the cPanel environment editor and restart.
#
# Defaults to http://localhost:3000 when unset, so development and Playwright
# work with no configuration. Set it explicitly in production.
SITE_URL=https://dhakabypass.com

# ---------------------------------------------------------------------------
# Database (mysql2, no ORM)
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Auth (NextAuth)
# ---------------------------------------------------------------------------
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAIL=
ADMIN_EMAILS=
ADMIN_NAME=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Where admin uploads are written. Outside public/ on purpose; served by
# app/uploads/[...path]/route.js.
MEDIA_ROOT=
